# AI 微服务配置模板。复制为 .env 并填入真实值（.env 已被 gitignore，勿提交）。
PORT=8790

# DeepSeek（OpenAI 兼容）。key 仅存于此，绝不进 Yii2 / Android / git。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 与 Yii2 共享的内部签名密钥（HMAC-SHA256）。两端一致，随机长串。
INTERNAL_SIGN_SECRET=change-me-to-a-long-random-shared-secret
# 请求时间戳容差（秒），防重放
SIGN_TTL_SECONDS=300
